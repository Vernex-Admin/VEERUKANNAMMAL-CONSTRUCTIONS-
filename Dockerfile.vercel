FROM dunglas/frankenphp:1-php8.4-bookworm

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

ENV COMPOSER_ALLOW_SUPERUSER=1 \
    COMPOSER_CACHE_DIR=/tmp/composer-cache

WORKDIR /app

COPY composer.json composer.lock ./
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends unzip; \
    install-php-extensions zip; \
    php -r 'exit(extension_loaded("zip") ? 0 : 1);'; \
    command -v unzip >/dev/null; \
    composer install --no-dev --no-interaction --prefer-dist --no-progress --optimize-autoloader; \
    test -f vendor/autoload.php; \
    test -f vendor/resend/resend-php/src/Resend.php; \
    rm -rf "$COMPOSER_CACHE_DIR" /var/lib/apt/lists/*

COPY . .
COPY Caddyfile /etc/caddy/Caddyfile

CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]
